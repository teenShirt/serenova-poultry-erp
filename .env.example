# Copy to .env and fill in. All settings are optional except the database password.

# --- Web server ---
PORT=3000
HOST=0.0.0.0

# --- MySQL 8.0.19 or newer ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=poultry
DB_PASSWORD=change-me
# The farm database. Demonstration data goes into <DB_NAME>_demo on the same server.
DB_NAME=poultry_farm
DB_CONNECTIONS=10
DEMO_ENABLED=true

# --- Files ---
# Backups are written here (default: ./data/backups)
# BACKUP_DIR=/var/backups/poultry-farm
MAX_UPLOAD_MB=512

# --- Security ---
# Strongly recommended on a server reachable from the internet: the first-run setup screen
# then asks for this key, so nobody else can claim a fresh installation.
SETUP_KEY=
# Sign-in sessions end after this many hours without activity.
SESSION_IDLE_HOURS=12
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Number of reverse proxies (e.g. nginx) in front of the server.
TRUST_PROXY=0

# --- Environment and releases ---
# development, staging or production. Production refuses to start without SETUP_KEY,
# COOKIE_SECURE=true, DB_PASSWORD, its own (non-root) DB_USER, DEMO_ENABLED=false and BACKUP_ENCRYPTION_KEY.
APP_ENV=development
# Sign-in, sign-up and password-reset attempts allowed per minute from one address.
AUTH_REQUESTS_PER_MINUTE=10

# --- Backups ---
# Encrypts backup files at rest (32 bytes: openssl rand -hex 32). Keep a copy of the key apart
# from the server: encrypted backups cannot be read without it.
# BACKUP_ENCRYPTION_KEY=
# A separate, empty database (name containing "restore") where backups are test-restored weekly.
# RESTORE_TEST_DB_NAME=poultry_restore_test

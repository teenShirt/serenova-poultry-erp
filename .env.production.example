# Settings for the production server. Copy to /opt/serenova/shared/.env on that server (chmod 600) and fill in.
# Never commit the filled-in file.
APP_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
COOKIE_SECURE=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=serenova
DB_PASSWORD=
DB_NAME=serenova
DB_CONNECTIONS=10
DEMO_ENABLED=false

BACKUP_DIR=/opt/serenova/shared/data/backups
# openssl rand -hex 32 — keep a copy apart from the server
BACKUP_ENCRYPTION_KEY=
RESTORE_TEST_DB_NAME=serenova_restore_test

# A long random value; the first-run setup asks for it
SETUP_KEY=
SESSION_IDLE_HOURS=12
AUTH_REQUESTS_PER_MINUTE=10
MAX_UPLOAD_MB=512

{
  "name": "poultry-farm-manager-web",
  "productName": "Poultry Farm Manager",
  "version": "2.1.0",
  "description": "Poultry farm management web application (Node.js + React + MySQL)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --tsconfig tsconfig.node.json --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "migrate": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/migrate.ts",
    "import-sqlite": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/import-sqlite.ts",
    "reset-password": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/reset-password.ts",
    "restore-database": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/restore-database.ts",
    "restore-test": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/restore-test.ts",
    "create-super-admin": "tsx --tsconfig tsconfig.node.json --env-file-if-exists=.env scripts/create-super-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "lint": "eslint src/server src/shared tests scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "lucide-react": "^1.56.0",
    "mysql-memory-server": "^1.13.0",
    "prettier": "3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.20.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
